# Independent witness; production requires a second provider for confirmations.
BCH_WITNESS_HOST=
BCH_WITNESS_PORT=
CRON_SECRET=
# Provided, publicly displayed competition details.
WIDGET_FACTORY_URL=
EMBER_DONATION_ADDRESS=
PUBLIC_PROOF_REFUND_ID=
PREEXISTING_WORK_DISCLOSURE=Built for BCH BLAZE 2026; open-source libraries disclosed in THIRD_PARTY_NOTICES.md.
