{
  "name": "returntail",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --exclude 'tests/db/**'",
    "test:integration": "vitest run tests/db",
    "test:e2e": "playwright test",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "proof:network": "node --env-file-if-exists=.env.local --import tsx scripts/network-proof.ts",
    "reconcile": "node --env-file-if-exists=.env.local --import tsx scripts/reconcile.ts",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "proof:providers": "node --import tsx scripts/check-providers.ts",
    "smoke": "node scripts/production-smoke.mjs",
    "brand:build": "node scripts/brand-assets.mjs"
  },
  "dependencies": {
    "@bitauth/libauth": "3.0.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/rethink-sans": "5.3.0",
    "@wizardconnect/core": "0.2.10",
    "@wizardconnect/dapp": "0.2.7",
    "@wizardconnect/react": "0.2.6",
    "lucide-react": "1.74.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "fontkit": "3.0.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "type": "module"
}
